{
  "name": "solana-memecoin-scanner",
  "version": "0.1.0",
  "description": "Read-only Solana memecoin signal scanner with Telegram alerts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:readonly": "bash scripts/check-readonly.sh",
    "check": "npm run typecheck && npm run lint && npm run lint:readonly && npm test"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "grammy": "^1.38.2",
    "p-limit": "^6.2.0",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
