{
  "name": "southpark-lead-capture-demo",
  "version": "1.0.0",
  "description": "Inbound AI lead capture demo for Southpark Construction (Vapi + Twilio + n8n + Airtable)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:prompt": "tsx scripts/generate-vapi-prompt.ts",
    "generate:assistant": "tsx scripts/generate-vapi-assistant.ts",
    "sync:vapi": "tsx scripts/sync-vapi.ts",
    "wire:vapi": "tsx scripts/wire-vapi.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "pino": "^9.9.0",
    "twilio": "^5.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.0",
    "@vercel/node": "^5.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
