# ─── Telegram ────────────────────────────────────────────────────────────────
# From @BotFather: /newbot → copy the token here.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id. Message @userinfobot to get it.
# Comma-separate if more than one person may drive the bot.
TELEGRAM_OWNER_IDS=

# ─── Safety ──────────────────────────────────────────────────────────────────
# true  = full pipeline runs, publishing is simulated and logged. Nothing posts.
# false = live publishing. Only flip this once you have tested in dry run.
DRY_RUN=true

# ─── Runtime ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
DB_PATH=./data/bot.db

# ─── Platform credentials ────────────────────────────────────────────────────
# Leave blank until each platform's approval lands. A blank credential simply
# marks that publisher "not connected"; it never crashes the bot.

# YouTube (Google Cloud → YouTube Data API v3 → OAuth client)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram (Meta app, Instagram Business account)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# TikTok (developer app, video.publish scope)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_MEMBER_URN=

# X / Twitter
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ─── Media hosting ───────────────────────────────────────────────────────────
# Instagram fetches video from a public URL — it will not accept a file upload.
# Cloudflare R2 or any S3-compatible bucket with public read.
MEDIA_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── AI post generation — FREE ───────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Daily posts (recommended workflow) ─────────────────────────────────────
# Bot sends you an image + caption every day. You post manually to your socials.
# No Instagram API or S3 needed.
DAILY_POST_ENABLED=true
DAILY_POST_HOUR=9
DAILY_POST_TIMEZONE=America/New_York
# Describe your brand or niche — the bot creates a fresh post from this each day.
DAILY_POST_PROMPT=
