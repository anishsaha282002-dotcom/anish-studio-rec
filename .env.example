# Required: free tier at https://helius.dev
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Optional: improves rate limits for safety checks
RUGCHECK_API_KEY=

# Optional: Jupiter (lite quote works without key; v2 build benefits from key)
JUPITER_API_KEY=

# Optional: Telegram call-channel ingest (never triggers buys alone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_IDS=

# Trading mode — leave false for paper trading
LIVE_TRADING=false

# Burner wallet keypair path (created by setup_wallet.py — never your Phantom seed)
WALLET_KEYPAIR_PATH=./burner-keypair.json

# Strategy knobs
MIN_LIQUIDITY_USD=150000
MIN_TOKEN_AGE_HOURS=24
MAX_TOP10_HOLDER_PCT=30
MIN_SCORE_TO_BUY=60
POSITION_SIZE_USD=12
POLL_INTERVAL_SEC=60
STARTING_CASH_USD=100
SLIPPAGE_BPS=100

# Exit rules
STOP_LOSS_PCT=8
TAKE_PROFIT_1_PCT=15
TAKE_PROFIT_1_FRACTION=0.4
TAKE_PROFIT_2_PCT=30
TAKE_PROFIT_2_FRACTION=0.4
TRAILING_STOP_PCT=10
TRAILING_ACTIVATION_PCT=10
TIME_STOP_HOURS=48
LP_PULL_DROP_PCT=30

# Risk caps
MAX_CONCURRENT_POSITIONS=3
MAX_DAILY_LOSS_USD=15
MAX_TOTAL_LOSS_USD=30
MAX_TRADES_PER_DAY=5
